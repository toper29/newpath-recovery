generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(uuid())
  username            String              @unique
  email               String              @unique
  password            String
  phone               String?
  role                String              @default("USER")
  membership_status   String              @default("FREE")
  premium_start_date  DateTime?
  premium_expiry_date DateTime?
  donation_status     String?             @default("NONE")
  admin_override      Boolean             @default(false)
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  xp                  Int                 @default(0)
  level               Int                 @default(1)
  streak              Int                 @default(0)
  longestStreak       Int                 @default(0)
  programStartedAt    DateTime?
  addictionTests      AddictionTest[]
  completions         ArticleCompletion[]
  challengeProgress   ChallengeProgress[]
  dailyCheckIns       DailyCheckIn[]
  featureUsages       FeatureUsage[]
  gameSessions        GameSession[]
  achievements        UserAchievement[]
  gamblingReports     GamblingReport[]
  notifications       Notification[]
  userPreference      UserPreference?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([email])
}

model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  title       String
  description String
  mission     String
  category    String
  targetValue Int
  iconName    String
  rewardTitle String?
  createdAt   DateTime          @default(now())
  userRel     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  isUnlocked    Boolean     @default(false)
  unlockedAt    DateTime?
  updatedAt     DateTime    @updatedAt
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model AddictionTest {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  category  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChallengeProgress {
  id           String   @id @default(uuid())
  userId       String
  dayCompleted Int
  status       String   @default("in-progress")
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeatureUsage {
  id          String   @id @default(uuid())
  userId      String
  featureName String
  usedAt      DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GameSession {
  id       String   @id @default(uuid())
  userId   String
  game     String
  xpEarned Int
  level    Int?
  score    Int?
  playedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityLog {
  id        String   @id @default(uuid())
  type      String
  details   String
  ipAddress String
  timestamp DateTime @default(now())
}

model DailyCheckIn {
  id                 String   @id @default(uuid())
  userId             String
  checkedAt          DateTime @default(now())
  didGamble          Boolean
  feltLikeDepositing Boolean
  openedGamblingSite Boolean
  riskScore          Float?
  note               String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Article {
  id          String              @id @default(uuid())
  title       String
  content     String
  category    String              @default("Uncategorized")
  thumbnail   String?
  createdBy   String
  createdAt   DateTime            @default(now())
  completions ArticleCompletion[]
}

model ArticleCompletion {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

model SystemSetting {
  key   String @id
  value String
}

model GameThreshold {
  id        String   @id @default(uuid())
  gameName  String   @unique
  minScore  Int      @default(0)
  xpReward  Int      @default(10)
  timeLimit Int      @default(60)
  updatedAt DateTime @updatedAt
}

model LandingPageContent {
  id          String   @id @default("singleton")
  heroTitle   String
  heroSub     String
  stats_users String
  stats_rate  String
  updatedAt   DateTime @updatedAt
}

model GamblingReport {
  id            String   @id @default(uuid())
  userId        String?
  siteName      String
  siteLink      String
  hasRegistered Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Feature {
  id          String   @id @default(uuid())
  iconName    String
  title       String
  description String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(uuid())
  author     String
  role       String?
  content    String
  avatarUrl  String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  role      String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, role])
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  hideExplanations String[]
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String
  action    String
  target    String?
  details   String?
  ipAddress String?
  userAgent String?
  path      String?
  createdAt DateTime @default(now())
}
